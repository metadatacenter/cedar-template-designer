{
  "name": "cedar-template-designer",
  "version": "2.9.29-SNAPSHOT",
  "publishConfig": {
    "registry": "https://nexus.bmir.stanford.edu/repository/npm-cedar/"
  },
  "description": "Authenticated CED host for CEDAR Workspace",
  "main": "app/scripts/host.mjs",
  "cedarJavaConformance": true,
  "scripts": {
    "start": "node scripts/designer.mjs start",
    "prepare:components": "node scripts/stage-components.mjs && node scripts/stage-design.mjs",
    "test": "node --test test/*.test.mjs",
    "pretest:browser": "node scripts/stage-policy.mjs",
    "test:browser": "npm --prefix browser test",
    "pretest": "node scripts/stage-policy.mjs"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  },
  "author": "Metadatacenter.org",
  "license": "BSD-2-Clause",
  "devDependencies": {
    "@org.metadatacenter/cedar-design-tokens": "0.1.0-dev.20261021.c0dd06d3"
  },
  "dependencies": {
    "cedar-embeddable-designer": "npm:@org.metadatacenter/cedar-embeddable-designer@0.1.0-dev.20261023.05a7d676",
    "cedar-embeddable-editor": "npm:@org.metadatacenter/cedar-embeddable-editor@2.0.29-dev.20261023.e98b5e0",
    "cedar-embeddable-term-picker": "npm:@org.metadatacenter/cedar-embeddable-term-picker@0.1.0-dev.20261023.347dbfba",
    "cedar-model-typescript-library": "npm:@org.metadatacenter/cedar-model-typescript-library@1.0.24-dev.20261023.6aafc06"
  }
}
