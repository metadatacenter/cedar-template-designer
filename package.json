{
  "name": "cedar-template-designer",
  "version": "2.9.37-SNAPSHOT",
  "publishConfig": {
    "registry": "https://nexus.bmir.stanford.edu/repository/npm-cedar/"
  },
  "description": "Authenticated CED host for CEDAR Workspace",
  "main": "app/scripts/host.mjs",
  "cedarJavaConformance": true,
  "scripts": {
    "start": "node scripts/designer.mjs start",
    "prepare:components": "node scripts/stage-components.mjs && node scripts/stage-design.mjs && node scripts/stage-host.mjs && npm run check:size",
    "test": "node --test test/*.test.mjs",
    "pretest:browser": "npm run prepare:components",
    "test:browser": "npm --prefix browser test",
    "pretest": "node scripts/stage-policy.mjs",
    "check:size": "node scripts/check-page-size.mjs"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.2": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.7": true
  },
  "author": "Metadatacenter.org",
  "license": "BSD-2-Clause",
  "devDependencies": {
    "@angular/build": "22.2.6",
    "@angular/cdk": "22.2.6",
    "@angular/cli": "22.2.6",
    "@angular/common": "22.2.4",
    "@angular/compiler": "22.2.4",
    "@angular/compiler-cli": "22.2.4",
    "@angular/core": "22.2.4",
    "@angular/elements": "22.2.4",
    "@angular/forms": "22.2.4",
    "@angular/material": "22.2.6",
    "@angular/platform-browser": "22.2.4",
    "@ngx-translate/core": "18.0.0",
    "@org.metadatacenter/cedar-design-tokens": "0.1.0-dev.20261113.aaacc4e7",
    "esbuild": "0.28.2",
    "jsonld": "9.0.0",
    "n3": "2.13.12",
    "rxjs": "7.8.2",
    "tslib": "2.9.1",
    "typescript": "6.0.3",
    "zone.js": "0.16.3"
  },
  "dependencies": {
    "cedar-embeddable-designer": "npm:@org.metadatacenter/cedar-embeddable-designer@0.1.3-dev.20261114.221a95da",
    "cedar-embeddable-editor": "npm:@org.metadatacenter/cedar-embeddable-editor@2.0.36-dev.20261114.aeaea0e",
    "cedar-embeddable-term-picker": "npm:@org.metadatacenter/cedar-embeddable-term-picker@0.1.3-dev.20261114.81668abe",
    "cedar-model-typescript-library": "npm:@org.metadatacenter/cedar-model-typescript-library@1.0.29-dev.20261114.8501ec0"
  },
  "engines": {
    "node": "^24.15.0"
  }
