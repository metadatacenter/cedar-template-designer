{
  "name": "cedar-template-designer",
  "version": "2.9.27-SNAPSHOT",
  "publishConfig": {
    "registry": "https://nexus.bmir.stanford.edu/repository/npm-cedar/"
  },
  "description": "Authenticated CED host for CEDAR Workspace",
  "main": "app/scripts/host.mjs",
  "scripts": {
    "start": "node scripts/designer.mjs start",
